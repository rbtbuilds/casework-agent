{
  "components": {
    "schemas": {
      "Action": {
        "enum": [
          "open_investigation",
          "manual_review"
        ],
        "type": "string"
      },
      "AnnotationIntent": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "expected_order_version": {
            "minimum": 1.0,
            "title": "Expected Order Version",
            "type": "integer"
          },
          "kind": {
            "const": "annotate_order",
            "default": "annotate_order",
            "title": "Kind",
            "type": "string"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "ticket_ref": {
            "const": "$ticket",
            "default": "$ticket",
            "title": "Ticket Ref",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "order_id",
          "action",
          "ticket_ref",
          "expected_order_version"
        ],
        "title": "AnnotationIntent",
        "type": "object"
      },
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "$ref": "#/components/schemas/JsonDict"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "case_id",
          "request_id",
          "details"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision",
            "type": "string"
          },
          "expected_case_version": {
            "minimum": 1.0,
            "title": "Expected Case Version",
            "type": "integer"
          },
          "proposal_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Proposal Hash",
            "type": "string"
          },
          "proposal_id": {
            "title": "Proposal Id",
            "type": "string"
          }
        },
        "required": [
          "proposal_id",
          "proposal_hash",
          "expected_case_version",
          "decision"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "AuditEvent": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/JsonDict"
          }
        },
        "required": [
          "id",
          "case_id",
          "kind",
          "payload",
          "created_at"
        ],
        "title": "AuditEvent",
        "type": "object"
      },
      "CarrierEvent": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "code": {
            "maxLength": 100,
            "title": "Code",
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "code",
          "at",
          "description"
        ],
        "title": "CarrierEvent",
        "type": "object"
      },
      "CaseSeed": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "fixture"
          },
          "order_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "scenario_id": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        "required": [
          "scenario_id",
          "order_id",
          "as_of"
        ],
        "title": "CaseSeed",
        "type": "object"
      },
      "CaseState": {
        "enum": [
          "new",
          "gathering",
          "needs_approval",
          "approved",
          "executing",
          "completed",
          "failed",
          "rejected",
          "cancelled",
          "stale",
          "review_required"
        ],
        "type": "string"
      },
      "CaseView": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "available_actions": {
            "items": {
              "enum": [
                "approve",
                "reject",
                "cancel",
                "repropose",
                "reconcile"
              ],
              "type": "string"
            },
            "title": "Available Actions",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "title": "Operations",
            "type": "array"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Proposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "scenario_id": {
            "title": "Scenario Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CaseState"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "scenario_id",
          "order_id",
          "as_of",
          "mode",
          "state",
          "version",
          "proposal",
          "evidence",
          "operations",
          "events",
          "available_actions",
          "error"
        ],
        "title": "CaseView",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Order"
              },
              {
                "$ref": "#/components/schemas/Shipment"
              },
              {
                "$ref": "#/components/schemas/Policy"
              }
            ],
            "title": "Payload"
          },
          "payload_hash": {
            "title": "Payload Hash",
            "type": "string"
          },
          "source": {
            "enum": [
              "order",
              "carrier",
              "policy"
            ],
            "title": "Source",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "title": "Source Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "case_id",
          "source",
          "source_id",
          "source_version",
          "payload",
          "payload_hash",
          "fetched_at"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Identifier": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "JsonDict": {
        "additionalProperties": {
          "$ref": "#/components/schemas/JsonValue"
        },
        "type": "object"
      },
      "JsonValue": {},
      "Mode": {
        "enum": [
          "fixture",
          "model"
        ],
        "type": "string"
      },
      "Operation": {
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "attempts": {
            "default": 0,
            "title": "Attempts",
            "type": "integer"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "kind": {
            "enum": [
              "create_ticket",
              "annotate_order"
            ],
            "title": "Kind",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "ordinal": {
            "enum": [
              1,
              2
            ],
            "title": "Ordinal",
            "type": "integer"
          },
          "remote_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remote Id"
          },
          "request_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Hash"
          },
          "request_json": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JsonDict"
              },
              {
                "type": "null"
              }
            ]
          },
          "response_json": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JsonDict"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/OperationState",
            "default": "pending"
          },
          "worker_generation": {
            "default": 0,
            "title": "Worker Generation",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "case_id",
          "approval_id",
          "ordinal",
          "kind",
          "key",
          "request_json",
          "request_hash",
          "state",
          "attempts",
          "remote_id",
          "response_json",
          "last_error",
          "worker_generation"
        ],
        "title": "Operation",
        "type": "object"
      },
      "OperationState": {
        "enum": [
          "pending",
          "in_flight",
          "unknown",
          "succeeded",
          "rejected"
        ],
        "type": "string"
      },
      "Order": {
        "additionalProperties": false,
        "properties": {
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/OrderAnnotation"
            },
            "title": "Annotations",
            "type": "array"
          },
          "note": {
            "default": "",
            "maxLength": 2000,
            "title": "Note",
            "type": "string"
          },
          "order_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "policy_exception": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Exception"
          },
          "shipment_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "status": {
            "enum": [
              "in_transit",
              "delivered",
              "cancelled",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "order_id",
          "shipment_id",
          "status",
          "version",
          "note",
          "policy_exception",
          "annotations"
        ],
        "title": "Order",
        "type": "object"
      },
      "OrderAnnotation": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "annotation_id": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Annotation Id",
            "type": "string"
          },
          "operation_key": {
            "title": "Operation Key",
            "type": "string"
          },
          "ticket_id": {
            "title": "Ticket Id",
            "type": "string"
          }
        },
        "required": [
          "annotation_id",
          "ticket_id",
          "action",
          "operation_key"
        ],
        "title": "OrderAnnotation",
        "type": "object"
      },
      "Policy": {
        "additionalProperties": false,
        "properties": {
          "approval_ttl_seconds": {
            "default": 900,
            "title": "Approval Ttl Seconds",
            "type": "integer"
          },
          "delay_hours": {
            "default": 48,
            "title": "Delay Hours",
            "type": "integer"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "title": "Rules",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "hash",
          "delay_hours",
          "approval_ttl_seconds",
          "rules"
        ],
        "title": "Policy",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "draft_note": {
            "title": "Draft Note",
            "type": "string"
          },
          "evidence_hashes": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Hashes",
            "type": "array"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "intents": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/components/schemas/TicketIntent"
              },
              {
                "$ref": "#/components/schemas/AnnotationIntent"
              }
            ],
            "title": "Intents",
            "type": "array"
          },
          "order_version": {
            "title": "Order Version",
            "type": "integer"
          },
          "policy_hash": {
            "title": "Policy Hash",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "shipment_version": {
            "title": "Shipment Version",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "case_id",
          "version",
          "policy_hash",
          "evidence_ids",
          "evidence_hashes",
          "order_version",
          "shipment_version",
          "action",
          "rationale",
          "draft_note",
          "intents",
          "created_at",
          "expires_at",
          "hash"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "Queue": {
        "enum": [
          "delivery_investigation",
          "human_review"
        ],
        "type": "string"
      },
      "Shipment": {
        "additionalProperties": false,
        "properties": {
          "conflicting_events": {
            "default": false,
            "title": "Conflicting Events",
            "type": "boolean"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/CarrierEvent"
            },
            "title": "Events",
            "type": "array"
          },
          "last_event_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Event At"
          },
          "shipment_id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "status": {
            "enum": [
              "delayed",
              "in_transit",
              "delivered",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "shipment_id",
          "status",
          "version",
          "last_event_at",
          "conflicting_events",
          "events"
        ],
        "title": "Shipment",
        "type": "object"
      },
      "TicketIntent": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "internal_note": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Internal Note",
            "type": "string"
          },
          "kind": {
            "const": "create_ticket",
            "default": "create_ticket",
            "title": "Kind",
            "type": "string"
          },
          "order_id": {
            "title": "Order Id",
            "type": "string"
          },
          "priority": {
            "const": "normal",
            "default": "normal",
            "title": "Priority",
            "type": "string"
          },
          "queue": {
            "$ref": "#/components/schemas/Queue"
          }
        },
        "required": [
          "kind",
          "order_id",
          "action",
          "queue",
          "priority",
          "internal_note"
        ],
        "title": "TicketIntent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_case_version": {
            "minimum": 1.0,
            "title": "Expected Case Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_case_version"
        ],
        "title": "VersionRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Casework Agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/cases": {
      "get": {
        "operationId": "cases_v1_cases_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseView"
                  },
                  "title": "Response Cases V1 Cases Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Cases"
      },
      "post": {
        "operationId": "create_v1_cases_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseSeed"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create"
      }
    },
    "/v1/cases/{id}": {
      "get": {
        "operationId": "case_v1_cases__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
